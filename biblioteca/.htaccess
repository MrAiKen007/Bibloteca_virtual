# ============================================
# BIBLIO - Biblioteca Virtual .htaccess
# ============================================

# Servir index.html (frontend) por defeito em vez de index.php
DirectoryIndex index.html index.php

# Proteger arquivo .env
<Files .env>
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</Files>

# CORS Headers (nível Apache - sempre enviados, mesmo para OPTIONS preflight)
<IfModule mod_headers.c>
    Header always setifempty Access-Control-Allow-Origin "*"
    Header always set Access-Control-Allow-Methods "GET, POST, OPTIONS, PUT, DELETE"
    Header always set Access-Control-Allow-Headers "Content-Type, Authorization, X-Requested-With"
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-XSS-Protection "1; mode=block"
</IfModule>

# Ativar rewrite URL
RewriteEngine On

# Responder a OPTIONS preflight sem passar ao PHP
RewriteCond %{REQUEST_METHOD} OPTIONS
RewriteRule .* - [R=204,L]

# Redirecionar todas as requisições para index.php
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.*)$ index.php?url=$1 [QSA,L]

# Desativar listagem de diretórios
Options -Indexes
